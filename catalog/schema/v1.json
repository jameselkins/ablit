{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jameselkins/ablit/blob/main/catalog/schema/v1.json",
  "title": "ablit catalog entry, schema version 1",
  "description": "One build of one model. Entries hold data only and never carry shell commands. A byte count may be null in a file that has not been filled in yet, and tools/verify_entry.py --fill writes the real values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "display_name", "source", "artifacts", "staging", "profile", "sources", "tests", "status"],
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$", "maxLength": 64 },
    "display_name": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "revision", "license", "modification"],
      "properties": {
        "repo": { "$ref": "#/$defs/repo" },
        "revision": { "$ref": "#/$defs/revision" },
        "license": { "type": "string", "minLength": 1 },
        "base_model": { "type": ["string", "null"] },
        "modification": { "enum": ["none", "abliterated", "finetune", "quantized"] }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "staging": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/step_download" },
          { "$ref": "#/$defs/step_transform_join" },
          { "$ref": "#/$defs/step_transform_extract" }
        ]
      }
    },
    "profile": { "$ref": "#/$defs/profile" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          { "type": "string", "pattern": "^https://" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "covers"],
            "properties": {
              "url": { "type": "string", "pattern": "^https://" },
              "covers": { "type": "array", "items": { "type": "string", "pattern": "^profile\\." } },
              "note": { "type": "string" }
            }
          }
        ]
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["backend", "date"],
        "properties": {
          "backend": { "type": "string" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "log": { "type": "string" }
        }
      }
    },
    "status": { "enum": ["unverified", "boot-tested", "removed"] },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "if": { "required": ["status"], "properties": { "status": { "const": "boot-tested" } } },
  "then": { "properties": { "tests": { "minItems": 1 } } },
  "$defs": {
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "role"],
      "properties": {
        "repo": { "$ref": "#/$defs/repo" },
        "revision": { "$ref": "#/$defs/revision" },
        "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).+$" },
        "bytes": { "type": ["integer", "null"], "minimum": 0 },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "git_blob_id": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "role": {
          "enum": ["weight", "draft", "tokenizer", "config", "rank", "expert-map", "checksum", "script", "engram-source", "engram-index", "engram"]
        }
      }
    },
    "step_download": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "artifacts"],
      "properties": {
        "step": { "const": "download" },
        "artifacts": {
          "anyOf": [
            { "const": "all" },
            { "type": "array", "minItems": 1, "items": { "type": "string" } }
          ]
        }
      }
    },
    "step_transform_join": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "inputs", "output_bytes"],
      "properties": {
        "step": { "const": "join" },
        "inputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "output_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "keeps_inputs_until_done": { "type": "boolean" },
        "delete_inputs_after": { "type": "boolean" }
      }
    },
    "step_transform_extract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "inputs", "output_bytes", "keeps_inputs_until_done"],
      "properties": {
        "step": { "const": "engram-extract" },
        "inputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "output_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "keeps_inputs_until_done": { "type": "boolean" },
        "delete_inputs_after": { "type": "boolean" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine", "engine_lock", "gpu", "host_ram_gb", "storage", "context_tokens",
        "concurrency", "port", "startup_hours_estimate", "min_download_mbps"
      ],
      "properties": {
        "engine": { "enum": ["vllm", "llamacpp", "xolotl"] },
        "engine_lock": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "gpu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vendor", "count", "vram_gb_each"],
          "properties": {
            "vendor": { "enum": ["nvidia", "amd"] },
            "count": { "type": "integer", "minimum": 1 },
            "vram_gb_each": { "type": "number", "exclusiveMinimum": 0 },
            "vram_gb_total": { "type": "number", "exclusiveMinimum": 0 },
            "compute_capability_min": { "type": ["number", "null"], "exclusiveMinimum": 0 }
          }
        },
        "host_ram_gb": { "type": "number", "exclusiveMinimum": 0 },
        "host_ram_gb_recommended": { "type": "number", "exclusiveMinimum": 0 },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["random_read_required"],
          "properties": {
            "random_read_required": { "type": "boolean" },
            "disk_gb_claimed": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "context_tokens": { "type": "integer", "minimum": 1 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "startup_hours_estimate": { "type": "number", "exclusiveMinimum": 0 },
        "min_download_mbps": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
